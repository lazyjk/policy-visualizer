# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
.venv/
venv/
env/

# Test cache
.pytest_cache/
.coverage
htmlcov/

# Generated diagram output
*.svg
*.png
*.pdf
# Allow tracked assets (e.g. README screenshots)
!docs/assets/**
# App logo shown on the upload screen (served from frontend/public)
!frontend/public/policy_visualizer_logo.svg

# Reference files (sensitive policy exports)
reference-files/

# Local Docker Compose settings (PV_PORT, PV_BIND_ADDRESS, ...)
.env

# Local project reviews (describe weaknesses / point at fixture data) — keep local
docs/reviews/

# Node / frontend
frontend/node_modules/
frontend/dist/

# macOS
.DS_Store

# Claude Code local settings
.claude/settings.local.json

# Project spec (contains internal policy details)
[Cc][Ll][Aa][Uu][Dd][Ee].md

# JetBrains IDEs
.idea/

# VSCode
.vscode/

# ClearPass DB backups (contain secret-bearing tables) — never commit
*.pgdump
*.dump

# Policy exports and diagram exports saved in the project folder — never
# commit real customer data. Sanitized test fixtures are allowed back in below.
*.xml
*.copy.txt
*.drawio
*.zip
*.jpg
*.jpeg
!tests/fixtures/**/*.xml
!tests/fixtures/**/*.copy.txt
# JSON downloads (e.g. coverage report) saved at the repo root; config files
# such as frontend/package.json live in subfolders and are unaffected.
/*.json
